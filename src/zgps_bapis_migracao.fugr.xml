    <item>
     <DOKIL>
      <ID>FU</ID>
      <OBJECT>BAPI_ZPROJECTDEF_ZCREATE      PROJECT_DEFINITION_STRU</OBJECT>
      <LANGU>D</LANGU>
      <TYP>T</TYP>
      <VERSION>0002</VERSION>
      <TXTLINES>00042</TXTLINES>
      <DOKSTATE>A</DOKSTATE>
     </DOKIL>
     <HEAD>
      <TDOBJECT>DOKU</TDOBJECT>
      <TDNAME>BAPI_ZPROJECTDEF_ZCREATE      PROJECT_DEFINITION_STRU</TDNAME>
      <TDID>FU</TDID>
      <TDSPRAS>D</TDSPRAS>
      <TDFORM>S_DOCU_SHOW</TDFORM>
      <TDSTYLE>S_DOCUS1</TDSTYLE>
      <TDVERSION>00002</TDVERSION>
      <TDLINESIZE>072</TDLINESIZE>
     </HEAD>
     <LINES>
      <TLINE>
       <TDFORMAT>U1</TDFORMAT>
       <TDLINE>&amp;MEANING&amp;</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>AS</TDFORMAT>
       <TDLINE>In dieser Struktur werden die für das gesamte Projekt verbindlichen</TDLINE>
      </TLINE>
      <TLINE>
       <TDLINE>Daten übergeben. Informationen zur Bedeutung der einzelnen Parameter</TDLINE>
      </TLINE>
      <TLINE>
       <TDLINE>finden Sie in der entsprechenden Datenelement-Dokumentation.</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>AS</TDFORMAT>
       <TDLINE>Für Währung und Zeiteinheit können Sie alternativ die SAP-interne</TDLINE>
      </TLINE>
      <TLINE>
       <TDLINE>Bezeichnung (PS_PWHIE bzw. PS_ZTEHT) oder den ISO-CODE (ISOCD bzw.</TDLINE>
      </TLINE>
      <TLINE>
       <TDLINE>ISOCD_UNIT) verwenden.</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>LZ</TDFORMAT>
      </TLINE>
      <TLINE>
       <TDFORMAT>T2</TDFORMAT>
       <TDLINE>PROJECT_DEFINITION,,&lt;DS:DE.PS_PSPID&gt;Projektdefinition&lt;/&gt;</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>T2</TDFORMAT>
       <TDLINE>DESCRIPTION,,&lt;DS:DE.PS_POST1&gt;PS: Kurzbeschreibung (erste Textzeile)&lt;/&gt;</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>T2</TDFORMAT>
       <TDLINE>MASK_ID,,&lt;DS:DE.PS_KIMSK&gt;Auswahlmaske für Kurz-ID PSP-Elemente&lt;/&gt;</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>T2</TDFORMAT>
       <TDLINE>RESPONSIBLE_NO,,&lt;DS:DE.PS_VERNR&gt;Nummer des Verantwortlichen</TDLINE>
      </TLINE>
      <TLINE>
       <TDLINE>(Projektleiter)&lt;/&gt;</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>T2</TDFORMAT>
       <TDLINE>APPLICANT_NO,,&lt;DS:DE.PS_ASTNR&gt;Nummer des Antragstellers&lt;/&gt;</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>T2</TDFORMAT>
       <TDLINE>COMP_CODE,,&lt;DS:DE.BUKRS&gt;Buchungskreis&lt;/&gt;</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>T2</TDFORMAT>
       <TDLINE>BUS_AREA,,&lt;DS:DE.GSBER&gt;Geschäftsbereich&lt;/&gt;</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>T2</TDFORMAT>
       <TDLINE>CONTROLLING_AREA,,&lt;DS:DE.KOKRS&gt;Kostenrechnungskreis&lt;/&gt;</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>T2</TDFORMAT>
       <TDLINE>PROFIT_CTR,,&lt;DS:DE.PRCTR&gt;Profit Center&lt;/&gt;</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>T2</TDFORMAT>
       <TDLINE>PROJECT_CURRENCY,,&lt;DS:DE.PS_PWHIE&gt;Währung Projektstrukturplan</TDLINE>
      </TLINE>
      <TLINE>
       <TDLINE>(Projektdefinition)&lt;/&gt;</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>T2</TDFORMAT>
       <TDLINE>PROJECT_CURRENCY_ISO,,&lt;DS:DE.ISOCD&gt;Iso-Code Währung&lt;/&gt;</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>T2</TDFORMAT>
       <TDLINE>NETWORK_ASSIGNMENT,,&lt;DS:DE.PS_ZUORD&gt;Zuordnung Netzplan&lt;/&gt;</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>T2</TDFORMAT>
       <TDLINE>START,,&lt;DS:DE.PS_PLFAZ&gt;Geplanter Starttermin für Projekt&lt;/&gt;</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>T2</TDFORMAT>
       <TDLINE>FINISH,,&lt;DS:DE.PS_PLSEZ&gt;Geplanter Endtermin für Projekt&lt;/&gt;</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>T2</TDFORMAT>
       <TDLINE>PLANT,,&lt;DS:DE.WERKS_D&gt;Werk&lt;/&gt;</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>T2</TDFORMAT>
       <TDLINE>CALENDAR,,&lt;DS:DE.FABKL&gt;Schlüssel des Fabrikkalenders&lt;/&gt;</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>T2</TDFORMAT>
       <TDLINE>PLAN_BASIC,,&lt;DS:DE.PS_VGPLF&gt;Planungsform für die Ecktermine im</TDLINE>
      </TLINE>
      <TLINE>
       <TDLINE>Projekt&lt;/&gt;</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>T2</TDFORMAT>
       <TDLINE>PLAN_FCST,,&lt;DS:DE.PS_EWPLF&gt;Planungsform für die Prognosetermine im</TDLINE>
      </TLINE>
      <TLINE>
       <TDLINE>Projekt&lt;/&gt;</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>T2</TDFORMAT>
       <TDLINE>TIME_UNIT,,&lt;DS:DE.PS_ZTEHT&gt;Zeiteinheit Terminplanung&lt;/&gt;</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>T2</TDFORMAT>
       <TDLINE>TIME_UNIT_ISO,,&lt;DS:DE.ISOCD_UNIT&gt;ISO-Code Maßeinheit&lt;/&gt;</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>T2</TDFORMAT>
       <TDLINE>NETWORK_PROFILE,,&lt;DS:DE.PROFIDNZPL&gt;Netzplanprofil&lt;/&gt;</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>T2</TDFORMAT>
       <TDLINE>PROJECT_PROFILE,,&lt;DS:DE.PROFIDPROJ&gt;Projektprofil&lt;/&gt;</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>T2</TDFORMAT>
       <TDLINE>BUDGET_PROFILE,,&lt;DS:DE.BP_BPROFIL&gt;Budgetprofil&lt;/&gt;</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>T2</TDFORMAT>
       <TDLINE>PROJECT_STOCK,,&lt;DS:DE.PS_BESTAND&gt;Projektbestandsführung&lt;/&gt;</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>T2</TDFORMAT>
       <TDLINE>OBJECTCLASS,,&lt;DS:DE.SCOPE_CV&gt;Objektklasse&lt;/&gt;</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>T2</TDFORMAT>
       <TDLINE>STATISTICAL,,&lt;DS:DE.PS_XSTAT&gt;Statistisches PSP-Element (X)&lt;/&gt;</TDLINE>
      </TLINE>
