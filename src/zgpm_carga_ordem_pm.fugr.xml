    <item>
     <DOKIL>
      <ID>FU</ID>
      <OBJECT>BAPI_CRIAR_ORDEM_PM</OBJECT>
      <LANGU>D</LANGU>
      <TYP>T</TYP>
      <VERSION>0023</VERSION>
      <TXTLINES>00041</TXTLINES>
      <DOKSTATE>A</DOKSTATE>
     </DOKIL>
     <HEAD>
      <TDOBJECT>DOKU</TDOBJECT>
      <TDNAME>BAPI_CRIAR_ORDEM_PM</TDNAME>
      <TDID>FU</TDID>
      <TDSPRAS>D</TDSPRAS>
      <TDFORM>S_DOCU_SHOW</TDFORM>
      <TDSTYLE>S_DOCUS1</TDSTYLE>
      <TDVERSION>00023</TDVERSION>
      <TDLINESIZE>072</TDLINESIZE>
     </HEAD>
     <LINES>
      <TLINE>
       <TDFORMAT>U1</TDFORMAT>
       <TDLINE>&amp;FUNCTIONALITY&amp;</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>AS</TDFORMAT>
       <TDLINE>Netzplankopf (BOR-Objekttyp BUS2002001) anlegen. Bei jedem Aufruf</TDLINE>
      </TLINE>
      <TLINE>
       <TDLINE>dieses BAPIs kann nur ein Netzplan angelegt werden.</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>U1</TDFORMAT>
       <TDLINE>&amp;EXAMPLE&amp;</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>AS</TDFORMAT>
       <TDLINE>Übergeben Sie die Daten des neuen Netzplans im Parameter I_NETWORK.</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>B1</TDFORMAT>
       <TDLINE>Interne Nummernvergabe der Netzplannummer</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>/</TDFORMAT>
       <TDLINE>Das Netzplanprofil ist das einzige Mussfeld. Der BAPI scheitert, falls</TDLINE>
      </TLINE>
      <TLINE>
       <TDLINE>in der Schnittstelle eine externe Netzplannummer mitgegeben wird.</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>/</TDFORMAT>
       <TDLINE>Bei erfolgreicher Beendigung des BAPIs wird die endgültige</TDLINE>
      </TLINE>
      <TLINE>
       <TDLINE>Netzplannummer noch nicht ermittelt. Statt dessen steht im Protokoll in</TDLINE>
      </TLINE>
      <TLINE>
       <TDLINE>der Returntabelle ET_RETURN die temporäre Netzplannummer.</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>/</TDFORMAT>
       <TDLINE>Verwenden Sie diese temporäre Netzplannummer, falls Sie noch vor dem</TDLINE>
      </TLINE>
      <TLINE>
       <TDLINE>Verbuchen</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>B2</TDFORMAT>
       <TDLINE>diesen Netzplankopf ändern (BAPI_BUS2002_CHANGE)</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>B2</TDFORMAT>
       <TDLINE>Vorgänge zu diesem Netzplan anlegen (BAPI_BUS2002_ACT_CREATE_MULTI)</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>B2</TDFORMAT>
       <TDLINE>gerade zu diesem Netzplan angelegte Vorgänge ändern</TDLINE>
      </TLINE>
      <TLINE>
       <TDLINE>(BAPI_BUS2002_ACT_CHANGE_MULTI)</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>B2</TDFORMAT>
       <TDLINE>Vorgangselemente zu diesem Netzplan anlegen</TDLINE>
      </TLINE>
      <TLINE>
       <TDLINE>(BAPI_BUS2002_ACTELEM_CREATE_M)</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>B2</TDFORMAT>
       <TDLINE>gerade zu diesem Netzplan angelegte Vorgangselemente ändern</TDLINE>
      </TLINE>
      <TLINE>
       <TDLINE>(BAPI_BUS2002_ACTELEM_CHANGE)</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>B2</TDFORMAT>
       <TDLINE>Statusänderungen zu diesem Netzplan durchgeführen</TDLINE>
      </TLINE>
      <TLINE>
       <TDLINE>(BAPI_BUS2002_SET_STATUS)</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>/</TDFORMAT>
      </TLINE>
      <TLINE>
       <TDFORMAT>AL</TDFORMAT>
       <TDLINE>Erst nach dem erfolgreichen Pre-Commit wird in dessen Protokoll die</TDLINE>
      </TLINE>
      <TLINE>
       <TDLINE>endgültige ermittelte Netzplannummer, zusammen mit der aktuell</TDLINE>
      </TLINE>
      <TLINE>
       <TDLINE>zurückgegeben temporären Nummer, angezeigt. Alle zu diesem Netzplankopf</TDLINE>
      </TLINE>
      <TLINE>
       <TDLINE>abhängigen Meldungen im Protokoll des Pre-Commit (Kopf ändern, NV</TDLINE>
      </TLINE>
      <TLINE>
       <TDLINE>anlegen/ändern, VE anlegen/ändern) enthalten nur noch die endgültige</TDLINE>
      </TLINE>
      <TLINE>
       <TDLINE>Nummer.</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>AS</TDFORMAT>
      </TLINE>
      <TLINE>
       <TDFORMAT>B1</TDFORMAT>
       <TDLINE>Externe Nummernvergabe der Netzplannummer</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>/</TDFORMAT>
       <TDLINE>Neben dem Netzplanprofil ist auch die Netzplannummer ein Mussfeld -</TDLINE>
      </TLINE>
      <TLINE>
       <TDLINE>Ausnahme: die externe Netzplannummer wird via User Exit CNEX0012,</TDLINE>
      </TLINE>
      <TLINE>
       <TDLINE>Ableitung der Netzplannummer aus PSP-Element, ermittelt.</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>/</TDFORMAT>
       <TDLINE>Der BAPI scheitert, falls keine oder eine bereits verwendete externe</TDLINE>
      </TLINE>
      <TLINE>
       <TDLINE>Netzplannummer interfaced oder im User Exit ermittelt wird.</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>/</TDFORMAT>
       <TDLINE>Bei erfolgreicher Beendigung des BAPIs steht im Protokoll in der</TDLINE>
      </TLINE>
      <TLINE>
       <TDLINE>Returntabelle ET_RETURN bereits diese externe Netzplannummer. Scheitert</TDLINE>
      </TLINE>
      <TLINE>
       <TDLINE>der BAPI, wird die Sperre der externen Netzplannummer sofort wieder</TDLINE>
      </TLINE>
      <TLINE>
       <TDLINE>aufgehoben.</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>AS</TDFORMAT>
      </TLINE>
      <TLINE>
       <TDFORMAT>/:</TDFORMAT>
       <TDLINE>INCLUDE CNIF_PI_NOT_MRP_APPLICABLE OBJECT DOKU ID TX</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>AS</TDFORMAT>
      </TLINE>
      <TLINE>
       <TDFORMAT>/:</TDFORMAT>
       <TDLINE>INCLUDE CNIF_PI_NOT_AUTO_COSTING OBJECT DOKU ID TX</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>AS</TDFORMAT>
      </TLINE>
      <TLINE>
       <TDFORMAT>/:</TDFORMAT>
       <TDLINE>INCLUDE CNIF_PI_ET_RETURN OBJECT DOKU ID TX</TDLINE>
      </TLINE>
      <TLINE/>
      <TLINE/>
      <TLINE/>
      <TLINE/>
      <TLINE>
       <TDFORMAT>AS</TDFORMAT>
      </TLINE>
      <TLINE>
       <TDFORMAT>U1</TDFORMAT>
       <TDLINE>&amp;HINTS&amp;</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>/:</TDFORMAT>
       <TDLINE>INCLUDE CNIF_PI_BAPI_HINTS OBJECT DOKU ID TX</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>U1</TDFORMAT>
       <TDLINE>&amp;FURTHER_SOURCES_OF_INF&amp;</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>AS</TDFORMAT>
      </TLINE>
     </LINES>
    </item>
    <item>
     <DOKIL>
      <ID>FU</ID>
      <OBJECT>BAPI_CRIAR_ORDEM_PM</OBJECT>
      <LANGU>E</LANGU>
      <TYP>T</TYP>
      <VERSION>0023</VERSION>
      <MASTERLANG>X</MASTERLANG>
      <TXTLINES>00039</TXTLINES>
      <DOKSTATE>A</DOKSTATE>
     </DOKIL>
     <HEAD>
      <TDOBJECT>DOKU</TDOBJECT>
      <TDNAME>BAPI_CRIAR_ORDEM_PM</TDNAME>
      <TDID>FU</TDID>
      <TDSPRAS>E</TDSPRAS>
      <TDFORM>S_DOCU_SHOW</TDFORM>
      <TDSTYLE>S_DOCUS1</TDSTYLE>
      <TDVERSION>00023</TDVERSION>
      <TDLINESIZE>072</TDLINESIZE>
     </HEAD>
     <LINES>
      <TLINE>
       <TDFORMAT>U1</TDFORMAT>
       <TDLINE>&amp;FUNCTIONALITY&amp;</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>AS</TDFORMAT>
       <TDLINE>Create a network header (BOR object type BUS2002001). Only one network</TDLINE>
      </TLINE>
      <TLINE>
       <TDLINE>can be created each time this BAPI is called.</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>U1</TDFORMAT>
       <TDLINE>&amp;EXAMPLE&amp;</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>AS</TDFORMAT>
       <TDLINE>Transfer the data of the new network in parameter I_NETWORK.</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>B1</TDFORMAT>
       <TDLINE>Internal number assignment of the network number</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>/</TDFORMAT>
       <TDLINE>The network profile is the only required-entry field. The BAPI fails if</TDLINE>
      </TLINE>
      <TLINE>
       <TDLINE>an external network number is entered in the interface.</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>/</TDFORMAT>
       <TDLINE>When the BAPI finishes successfully, the final network number has not</TDLINE>
      </TLINE>
      <TLINE>
       <TDLINE>been determined yet. Instead, the log of the return table ET_RETURN</TDLINE>
      </TLINE>
      <TLINE>
       <TDLINE>contains a temporary network number.</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>/</TDFORMAT>
       <TDLINE>Use this temporary network number, if you do any of the following</TDLINE>
      </TLINE>
      <TLINE>
       <TDLINE>before carrying out the posting:</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>B2</TDFORMAT>
       <TDLINE>Change this network header (BAPI_BUS2002_CHANGE)</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>B2</TDFORMAT>
       <TDLINE>Create activities for this network (BAPI_BUS2002_ACT_CREATE_MULTI)</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>B2</TDFORMAT>
       <TDLINE>Change activities created for this network</TDLINE>
      </TLINE>
      <TLINE>
       <TDLINE>(BAPI_BUS2002_ACT_CHANGE_MULTI)</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>B2</TDFORMAT>
       <TDLINE>Create activity elements for this network</TDLINE>
      </TLINE>
      <TLINE>
       <TDLINE>(BAPI_BUS2002_ACTELEM_CREATE_M)</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>B2</TDFORMAT>
       <TDLINE>Change activity elements that were created for this network</TDLINE>
      </TLINE>
      <TLINE>
       <TDLINE>(BAPI_BUS2002_ACTELEM_CHANGE)</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>B2</TDFORMAT>
       <TDLINE>Carry out status changes for this network (BAPI_BUS2002_SET_STATUS)</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>/</TDFORMAT>
      </TLINE>
      <TLINE>
       <TDFORMAT>/</TDFORMAT>
      </TLINE>
      <TLINE>
       <TDFORMAT>/</TDFORMAT>
       <TDLINE>After the precommit is carried out successfully, the final network</TDLINE>
      </TLINE>
      <TLINE>
       <TDLINE>number along with the current temporary number are displayed in the log</TDLINE>
      </TLINE>
      <TLINE>
       <TDLINE>of the precommit. All dependent messages for this network header in the</TDLINE>
      </TLINE>
      <TLINE>
       <TDLINE>log of the precommit (change header, create/change network activities,</TDLINE>
      </TLINE>
      <TLINE>
       <TDLINE>create/change activity elements) contain the final number only.</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>AS</TDFORMAT>
      </TLINE>
      <TLINE>
       <TDFORMAT>B1</TDFORMAT>
       <TDLINE>External number assignment of the network number</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>/</TDFORMAT>
       <TDLINE>In addition to the network profile, the network number is also a</TDLINE>
      </TLINE>
      <TLINE>
       <TDLINE>required-entry field. Exception: the external network number is</TDLINE>
      </TLINE>
      <TLINE>
       <TDLINE>determined via user exit CNEX0012 &quot;Derive External Network Number from</TDLINE>
      </TLINE>
      <TLINE>
       <TDLINE>WBS Number&quot;.</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>/</TDFORMAT>
       <TDLINE>The BAPI fails if no external network number, or one that is already</TDLINE>
      </TLINE>
      <TLINE>
       <TDLINE>being used, is interfaced or determined in the user exit.</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>/</TDFORMAT>
       <TDLINE>If the BAPI finishes successfully, the log of the ET_RETURN return</TDLINE>
      </TLINE>
      <TLINE>
       <TDLINE>table already contains this external network number. If the BAPI fails,</TDLINE>
      </TLINE>
      <TLINE>
       <TDLINE>the lock of the external network number is immediately lifted.</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>AS</TDFORMAT>
      </TLINE>
      <TLINE>
       <TDFORMAT>/:</TDFORMAT>
       <TDLINE>INCLUDE CNIF_PI_NOT_MRP_APPLICABLE OBJECT DOKU ID TX</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>AS</TDFORMAT>
      </TLINE>
      <TLINE>
       <TDFORMAT>/:</TDFORMAT>
       <TDLINE>INCLUDE CNIF_PI_NOT_AUTO_COSTING OBJECT DOKU ID TX</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>AS</TDFORMAT>
      </TLINE>
      <TLINE>
       <TDFORMAT>/:</TDFORMAT>
       <TDLINE>INCLUDE CNIF_PI_ET_RETURN OBJECT DOKU ID TX</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>AS</TDFORMAT>
      </TLINE>
      <TLINE>
       <TDFORMAT>U1</TDFORMAT>
       <TDLINE>&amp;HINTS&amp;</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>/:</TDFORMAT>
       <TDLINE>INCLUDE CNIF_PI_BAPI_HINTS OBJECT DOKU ID TX</TDLINE>
      </TLINE>
      <TLINE>
