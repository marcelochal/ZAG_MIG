     <HEAD>
      <TDOBJECT>DOKU</TDOBJECT>
      <TDNAME>ZCD_EXTERN_PP_CALL</TDNAME>
      <TDID>FU</TDID>
      <TDSPRAS>D</TDSPRAS>
      <TDFORM>S_DOCU_SHOW</TDFORM>
      <TDSTYLE>S_DOCUS1</TDSTYLE>
      <TDVERSION>00003</TDVERSION>
      <TDLINESIZE>072</TDLINESIZE>
     </HEAD>
     <LINES>
      <TLINE>
       <TDFORMAT>U1</TDFORMAT>
       <TDLINE>&amp;FUNCTIONALITY&amp;</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>AS</TDFORMAT>
       <TDLINE>Mit dem Funktionsbaustein KCD_EXTERN_PP_CALL kann der Planungsprozessor</TDLINE>
      </TLINE>
      <TLINE>
       <TDLINE>von Externen Anwendungen über RFC Aufgerufen werden. Ein</TDLINE>
      </TLINE>
      <TLINE>
       <TDLINE>Erfassungslayout muß bei diesem Aufruf nicht existieren.</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>AS</TDFORMAT>
       <TDLINE>Es wird die Zieltabelle, eine Menge von Zellen und Strukturinformationen</TDLINE>
      </TLINE>
      <TLINE>
       <TDLINE>ans SAP-System übergeben.</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>AS</TDFORMAT>
       <TDLINE>Die Struktuinformationen werden in den Tabellen I_DATAR, I_HEAD und</TDLINE>
      </TLINE>
      <TLINE>
       <TDLINE>I_KEY übergeben. In I_DATAR steht im wesentlichen ein Koordinatentupel</TDLINE>
      </TLINE>
      <TLINE>
       <TDLINE>(OBEN Links; unten rechts) und das Zielfeld der Werte des Datenbereichs.</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>AS</TDFORMAT>
       <TDLINE>Über I_KEY und I_HEAD kann für Datenbereich angegeben werden, mit</TDLINE>
      </TLINE>
      <TLINE>
       <TDLINE>welchen Merkmalswerten die Werte verknüpft werden sollen.</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>AS</TDFORMAT>
       <TDLINE>Bei I_KEY können Einzelne Zellen mit einem Datenbereich unabhängig von</TDLINE>
      </TLINE>
      <TLINE>
       <TDLINE>der Position der Zelle mit Daten verbunden werden.</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>AS</TDFORMAT>
       <TDLINE>Bei I_HEAD werden Zeilen oder Spalten mit dem Datenbereich verbunden</TDLINE>
      </TLINE>
      <TLINE>
       <TDLINE>wobei jeweils die Daten mit in einer Zeile oder einer Spalte</TDLINE>
      </TLINE>
      <TLINE>
       <TDLINE>zusammengeführt werden.</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>AS</TDFORMAT>
       <TDLINE>Über die Importparameter wird die Zieltabelle angegeben. z.B. EIS;</TDLINE>
      </TLINE>
      <TLINE>
       <TDLINE>Aspekt. In der Tabelle I_INTERN werden Zellen: (Koordinaten (row; Col)</TDLINE>
      </TLINE>
      <TLINE>
       <TDLINE>und der Wert (Value)) übergeben.</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>U1</TDFORMAT>
       <TDLINE>&amp;EXAMPLE&amp;</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>AS</TDFORMAT>
      </TLINE>
      <TLINE>
       <TDFORMAT>U1</TDFORMAT>
